# Copy this file to .env and replace each xxxx with your own secret.
APP_NAME=Agentic RAG
APP_ENV=development

# Secrets
OPENROUTER_API_KEY=xxxx
TAVILY_API_KEY=xxxx
PINECONE_API_KEY=xxxx
ADMIN_API_KEY=xxxx

# Models and service configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Vision uses the OpenRouter key/base URL by default; override only if needed.
VISION_PROVIDER=openai_compatible
VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
VISION_API_KEY=
VISION_BASE_URL=
VISION_TIMEOUT_SECONDS=30
PDF_VISION_MAX_PAGES=8
PDF_VISION_MIN_IMAGE_AREA_RATIO=0.05
PDF_VISION_MIN_DRAWINGS=80
PDF_RENDER_DPI=150
PDF_VISION_MAX_PIXELS=20000000
PDF_VISION_MAX_IMAGE_BYTES=12582912
PDF_MIN_TEXT_WORDS=25
OCR_PROVIDER=tesseract
# Optional local override. Leave blank to use PATH; the production Docker image
# defaults to /usr/bin/tesseract. Never copy a Windows executable path to DO.
TESSERACT_CMD=
OCR_TIMEOUT_SECONDS=20
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
PINECONE_INDEX_NAME=fde-it-support-rag
PINECONE_NAMESPACE=company-it-kb
TOP_K=4
RETRIEVAL_CANDIDATE_K=12
MAX_RETRIES=1

# Local paths
AUDIT_DB_PATH=data/audit.db
CONVERSATION_DB_PATH=data/conversations.db
DOCUMENT_REGISTRY_DB_PATH=data/document_registry.db
UPLOAD_DIR=uploads
SAMPLE_KB_DIR=data/sample_kb
